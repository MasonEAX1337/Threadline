{
  "name": "threadline",
  "version": "0.1.0",
  "description": "Shared context for teams that build with agents.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "test:install": "playwright install chromium webkit",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasonEAX1337/Threadline.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/MasonEAX1337/Threadline/issues"
  },
  "homepage": "https://github.com/MasonEAX1337/Threadline#readme",
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.12.1"
}
